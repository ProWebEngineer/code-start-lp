---
interface Props {
  heading: string;
  steps: readonly string[];
}

const { heading, steps } = Astro.props;
---

<section class="section" aria-labelledby="flow-heading">
  <div class="wrap">
    <h2 id="flow-heading">{heading}</h2>
    <ol class="steps">
      {
        steps.map((step, index) => (
          <li>
            <p class="step-no">{index + 1}</p>
            <p class="step-text">{step}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
